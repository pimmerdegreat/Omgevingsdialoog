# Instellingen van Dialoogkaart. Kopieer dit bestand naar .env en vul de waarden in.
# Het bestand .env bevat wachtwoorden en hoort niet in GitHub.

# Verbinding met de database: postgres://GEBRUIKER:WACHTWOORD@HOST:POORT/DATABASE
DATABASE_URL=postgres://dialoog:VERVANG-DIT-WACHTWOORD@127.0.0.1:5432/dialoogkaart

# Wachtwoord om in te loggen in beheer. Kies een lang wachtwoord.
BEHEER_WACHTWOORD=

# Willekeurige tekst van minstens 32 tekens waarmee de inlogsessie wordt ondertekend.
# Zonder deze waarde moet je na elke herstart opnieuw inloggen.
SESSIE_GEHEIM=

# Poort en adres waarop de server luistert.
# 127.0.0.1 = alleen bereikbaar vanaf de server zelf, achter de reverse proxy (aanbevolen).
POORT=3000
HOST=127.0.0.1

# Zet beide op 1 zodra de site achter een reverse proxy met https staat.
ACHTER_PROXY=1
HTTPS_ALTIJD=1
NODE_ENV=production

# Bij een lege database het voorbeeldtraject met voorbeelddata aanmaken (1 = ja, 0 = nee).
VOORBEELD=1

# Naam en contactgegevens in het rapport en in de privacytekst van nieuwe trajecten.
ORGANISATIE_NAAM=Buro SRO
ORGANISATIE_WEBSITE=https://www.burosro.nl
ORGANISATIE_EMAIL=utrecht@buro-sro.nl

# Alleen nodig als het deelnemersdeel op een ander adres staat dan deze server (door komma's gescheiden).
TOEGESTANE_HERKOMST=

# Websites die Dialoogkaart in een kader (iframe) mogen tonen, door komma's gescheiden.
# Bijvoorbeeld de projectsite van een gemeente: https://www.voorbeeldgemeente.nl
INSLUITEN_OP=
