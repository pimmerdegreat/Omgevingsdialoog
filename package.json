{
	"name": "dialoogkaart",
	"version": "0.1.0",
	"private": true,
	"description": "Kaartgestuurde participatie voor Buro SRO: deelnemers tekenen en reageren op de kaart, resultaten als HTML-rapport en in QGIS.",
	"type": "module",
	"engines": {
		"node": ">=22.13"
	},
	"scripts": {
		"dev": "node --env-file-if-exists=.env --watch server/index.js",
		"dev:web": "vite --config web/vite.config.ts",
		"build": "vue-tsc --noEmit -p web/tsconfig.json && vite build --config web/vite.config.ts",
		"start": "node --env-file-if-exists=.env server/index.js",
		"seed": "node --env-file-if-exists=.env server/seed/run.js",
		"demo": "node server/seed/demo.js && vite build --config web/vite.config.ts --mode demo --outDir ../dist/demo",
		"test": "node --test \"server/test/*.test.js\""
	},
	"dependencies": {
		"@fastify/cookie": "^11.1.5",
		"@fastify/cors": "^11.4.3",
		"@fastify/multipart": "^10.1.8",
		"@fastify/rate-limit": "^11.2.2",
		"@fastify/static": "^10.1.11",
		"fastify": "^5.12.8",
		"leaflet": "^1.9.4",
		"leaflet.heat": "^1.0.1",
		"pg": "^8.23.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/leaflet": "^1.9.22",
		"@types/proj4": "^2.5.6",
		"@vitejs/plugin-vue": "^6.0.11",
		"proj4": "^2.23.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vue": "^3.5.45",
		"vue-router": "^5.5.1",
		"vue-tsc": "^3.3.14"
	}
}
